# Copia este archivo a .env y ajusta si tu máquina ya usa estos puertos.
# En Railway las mismas conexiones llegan como PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
# y REDISHOST/REDISPORT/REDISPASSWORD (application.yml acepta ambos nombres).

DB_HOST=localhost
DB_PORT=5433
DB_NAME=minijuego
DB_USER=minijuego
DB_PASSWORD=minijuego

REDIS_HOST=localhost
REDIS_PORT=6380

SERVER_PORT=8082

# OBLIGATORIO fuera de un laptop de desarrollo: debe ser exactamente el
# mismo JWT_SECRET con el que planazo-api-gateway firma sus JWT — de eso
# depende que este servicio pueda validar los tokens del gateway.
# Mínimo 32 caracteres (HS256).
JWT_SECRETO=cambia-este-secreto-de-desarrollo-minijuego-planazo-32b
