# Copia este archivo a .env y ajusta si tu máquina ya usa estos puertos.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=minijuego
DB_USER=minijuego
DB_PASSWORD=minijuego

REDIS_HOST=localhost
REDIS_PORT=6380

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

SERVER_PORT=8082

# OBLIGATORIO fuera de un laptop de desarrollo: debe ser exactamente el
# mismo secreto que usa el microservicio de Registro y autenticación para
# firmar sus JWT — de eso depende que este servicio pueda validar tokens
# emitidos por el otro. Mínimo 32 caracteres (HS256).
JWT_SECRETO=cambia-este-secreto-de-desarrollo-minijuego-planazo-32b
